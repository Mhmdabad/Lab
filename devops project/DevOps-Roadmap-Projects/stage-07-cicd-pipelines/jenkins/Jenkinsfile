// Jenkins implementation of the SAME pipeline (declarative syntax).
//
// To activate: create a Jenkins "Pipeline" (or Multibranch) job and point it
// at the repo with "Script Path" = stage-07-cicd-pipelines/jenkins/Jenkinsfile.
//
// Assumes the Jenkins agent can run docker (docker CLI + daemon available).
// Same 7 stages as the GitHub Actions and GitLab CI versions.

pipeline {
  agent any

  environment {
    APP_DIR = 'stage-07-cicd-pipelines/app'
    IMAGE   = "devops-roadmap/stage07:${env.GIT_COMMIT ?: 'local'}"
  }

  options {
    timestamps()
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {
    // ---- 1. SECRETS -------------------------------------------------------
    stage('Secrets: Gitleaks') {
      steps {
        sh '''
          docker run --rm -v "$PWD:/repo" zricethezav/gitleaks:latest \
            detect --source /repo --no-banner --verbose
        '''
      }
    }

    // ---- 2. SAST ----------------------------------------------------------
    stage('SAST: Semgrep') {
      steps {
        sh '''
          docker run --rm -v "$PWD:/src" returntocorp/semgrep:latest \
            semgrep --config p/ci --error /src
        '''
      }
    }

    // ---- 3. DEPS ----------------------------------------------------------
    stage('Deps: Trivy fs') {
      steps {
        sh '''
          docker run --rm -v "$PWD:/repo" aquasec/trivy:latest \
            fs --severity HIGH,CRITICAL --exit-code 1 "/repo/${APP_DIR}"
        '''
      }
    }

    // ---- 4. TEST ----------------------------------------------------------
    stage('Test: pytest') {
      steps {
        sh '''
          docker run --rm -v "$PWD:/repo" -w "/repo/${APP_DIR}" python:3.12-slim \
            sh -c "pip install -r requirements.txt && python -m pytest -v"
        '''
      }
    }

    // ---- 5. BUILD ---------------------------------------------------------
    stage('Build image') {
      steps {
        sh 'docker build -t "$IMAGE" "$APP_DIR"'
      }
    }

    // ---- 6. IMAGE-SCAN ----------------------------------------------------
    stage('Image scan: Trivy') {
      steps {
        sh '''
          docker run --rm -v /var/run/docker.sock:/var/run/docker.sock \
            aquasec/trivy:latest image --severity HIGH,CRITICAL \
            --ignore-unfixed --exit-code 1 "$IMAGE"
        '''
      }
    }

    // ---- 7. DEPLOY (main only, with manual approval) ----------------------
    stage('Deploy') {
      when { branch 'main' }
      steps {
        input message: 'Deploy to production?', ok: 'Deploy'
        sh '''
          echo "All gates green. Deploying $IMAGE ..."
          echo "Real deploy would push the image and run kubectl/helm."
        '''
      }
    }
  }

  post {
    success { echo 'Pipeline succeeded — all security gates passed.' }
    failure { echo 'Pipeline failed — check which gate blocked above.' }
  }
}
